{
  "name": "open-anatomy-3d",
  "version": "0.1.0",
  "description": "Open 3D human anatomy models (male and female) for the web: skin, skeleton, muscles, organs, vessels and nerves as separately named glTF meshes, with a typed catalog of every structure.",
  "keywords": ["anatomy", "human-body", "3d", "gltf", "glb", "three.js", "medical", "bodyparts3d", "webgl"],
  "license": "MIT AND CC-BY-4.0",
  "author": "MervinR07 (https://github.com/MervinR07)",
  "homepage": "https://github.com/MervinR07/open-anatomy-3d#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MervinR07/open-anatomy-3d.git",
    "directory": "packages/open-anatomy-3d"
  },
  "bugs": "https://github.com/MervinR07/open-anatomy-3d/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./catalog.json": "./catalog.json",
    "./models/*": "./models/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "models", "catalog.json", "ATTRIBUTION.md", "LICENSE", "LICENSE-MODELS.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p .",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
